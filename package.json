{
  "name": "tikdesk",
  "version": "1.4.0",
  "description": "Nieoficjalna aplikacja Windows do mobilnej strony TikToka",
  "author": "TikDesk contributors",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc -p tsconfig.json",
    "test:smoke": "electron . --smoke-test",
    "test:preferences": "node scripts/test-preferences.cjs",
    "test:package": "node scripts/test-package.cjs",
    "build": "electron-builder --win nsis --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "build": {
    "appId": "pl.tikdesk.desktop",
    "productName": "TikDesk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TikDesk",
      "artifactName": "TikDesk-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "undici": "8.12.4"
  }
}
